// Syntax-specific settings for JSON (Sublime Text, Packages/User).
// Symlinked into place by home.nix.
{
	// JSON Lines files: every line is a JSON value, so the JSON syntax highlights them fully.
	"extensions": ["jsonl", "ndjson"],

	// Wrap long lines (Sublime's "auto" leaves code syntaxes unwrapped), since a JSONL record is one line.
	"word_wrap": true,
}
